{
  "name": "hyperview",
  "version": "0.1.0",
  "description": "Fast, clean charting with custom-built indicators for traders.",
  "keywords": [
    "charting",
    "trading",
    "indicators",
    "technical-analysis",
    "candlestick",
    "finance"
  ],
  "private": true,
  "author": "lesenelir <hi@lesenelir.me>",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clear": "rm -rf .next out tsconfig.tsbuildinfo next-env.d.ts node_modules",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
